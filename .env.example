# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API. The publishable (anon) key is safe in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used by `npm run seed` to create test accounts and reset demo data.
# Never add this to Vercel or to any VITE_ variable.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Password given to every test account created by `npm run seed`.
TEST_USER_PASSWORD=choose-a-long-password

# Server-only. Used by /api/ask (the Ask assistant). Add it to Vercel too.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: override the assistant model (defaults to claude-haiku-5-5).
# ANTHROPIC_MODEL=claude-haiku-5-5
